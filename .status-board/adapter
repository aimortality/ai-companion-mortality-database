#!/usr/bin/env python3
"""status-board adapter — aimortality.org (research database).

WORKED EXAMPLE of a project adapter. Reads domain state that no off-the-shelf
tool surfaces (fatality counts from a tracked JSON file, the Tier-3 watch list,
and whether this week's triage run is merged or still on an open PR) and prints
the status-board JSON contract to stdout.

Copy this to <repo>/.status-board/adapter and make it executable. The generator
auto-discovers it there. Run with CWD = repo root; argv[1] = repo root.
"""
import json
import os
import re
import subprocess
import sys


def sh(args):
    try:
        return subprocess.run(args, capture_output=True, text=True,
                              check=True, timeout=60).stdout.strip()
    except Exception:
        return ""


def gh_json(args, default):
    out = sh(args)
    try:
        return json.loads(out) if out else default
    except json.JSONDecodeError:
        return default


def metadata_stats():
    try:
        with open("data/mortality-data.json", encoding="utf-8") as fh:
            d = json.load(fh)
    except Exception:
        return []
    m = d.get("metadata", {})
    deaths = m.get("total_fatalities") or m.get("total_deaths")
    return [
        {"label": "fatalities", "value": deaths},
        {"label": "incidents", "value": m.get("total_incidents")},
        {"label": "platforms", "value": m.get("total_platforms")},
        {"label": "data version", "value": m.get("version")},
        {"label": "data updated", "value": m.get("last_updated")},
    ]


def tier3_section():
    path = "../triage/tier3-monitor.md"  # private repo closestfriend/aimortality-triage, sibling checkout
    if not os.path.exists(path):
        return None
    rows, dates, statuses = 0, [], {}
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            if re.match(r"\s*\|\s*20\d\d-\d\d-\d\d\s*\|", line):
                cells = [c.strip() for c in line.strip().strip("|").split("|")]
                rows += 1
                dates.append(cells[0])
                st = cells[-1].lower()
                if st:
                    statuses[st] = statuses.get(st, 0) + 1
    pills = " ".join(
        f'<span class="tag">{k} · {v}</span>' for k, v in statuses.items())
    html = (f'<div class="meta">{rows} row(s) · latest lead '
            f'{max(dates) if dates else "—"}</div>'
            f'<div style="margin-top:8px">{pills}</div>')
    return {"title": "Tier-3 watch list", "html": html}


def triage_section():
    """Latest weekly-triage run — merged locally OR pending on an open PR."""
    base = "../triage/weekly-triage"  # private repo closestfriend/aimortality-triage, sibling checkout
    open_prs = gh_json(["gh", "pr", "list", "--state", "open", "--limit", "30",
                        "--json", "number,title,headRefName,url"], [])
    local = []
    if os.path.isdir(base):
        local = [d for d in os.listdir(base) if re.match(r"20\d\d-\d\d-\d\d$", d)]
    pr_runs = {}
    for pr in open_prs:
        mo = re.search(r"triage-(20\d\d-\d\d-\d\d)", pr.get("headRefName", "")) \
            or re.search(r"(20\d\d-\d\d-\d\d)", pr.get("title", ""))
        if mo and "triage" in (pr.get("headRefName", "") + pr.get("title", "")).lower():
            pr_runs[mo.group(1)] = pr
    cands = set(local) | set(pr_runs)
    if not cands:
        return None
    latest = max(cands)
    pending = latest in pr_runs and latest not in local

    items, files = [], []
    if pending:
        pr = pr_runs[latest]
        paths = gh_json(["gh", "pr", "view", str(pr["number"]), "--json", "files",
                         "--jq", "[.files[].path]"], [])
        files = [os.path.basename(p) for p in paths
                 if p.endswith(".md") and f"/{latest}/" in p]
        status_tag, href = "pending review", pr.get("url")
    else:
        d = os.path.join(base, latest)
        files = sorted(f for f in os.listdir(d) if f.endswith(".md"))
        status_tag, href = "merged", None
    for f in files:
        items.append({"left": f, "tag": "docket" if "docket" in f else "candidate"})
    head = (f'<div class="meta" style="margin-bottom:8px">run <b>{latest}</b> '
            f'· {status_tag} · {len(files)} file(s)'
            + (f' · <a href="{href}" target="_blank">PR #{pr_runs[latest]["number"]} →</a>'
               if pending else '') + '</div>')
    rows = "".join(
        f'<div class="row"><span>{f["left"]}</span>'
        f'<span class="tag">{f["tag"]}</span></div>' for f in items)
    return {"title": "Latest weekly triage", "html": head + rows}


def main():
    sections = [s for s in (triage_section(), tier3_section()) if s]
    print(json.dumps({
        "title": "AIMD · internal status",
        "stats": metadata_stats(),
        "sections": sections,
    }))


if __name__ == "__main__":
    main()
