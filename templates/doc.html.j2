{% extends "base.html.j2" %}
{% block head %}
  <style>
    :root {
      --bg: #ffffff;
      --text: #000000;
      --muted: #666666;
      --border: #000000;
      --border-soft: #e0e0e0;
      --panel: #f9f9f9;
      --link: #0000ff;
    }
    :root[data-theme="dark"] {
      --bg: #0f1113;
      --text: #f2f2f2;
      --muted: #b5b5b5;
      --border: #e6e6e6;
      --border-soft: #3a3a3a;
      --panel: #171a1d;
      --link: #8ab4f8;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg: #0f1113;
        --text: #f2f2f2;
        --muted: #b5b5b5;
        --border: #e6e6e6;
        --border-soft: #3a3a3a;
        --panel: #171a1d;
        --link: #8ab4f8;
      }
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'SF Mono', 'Menlo', 'Monaco', 'Courier New', monospace;
      font-size: 14px;
      line-height: 1.7;
      color: var(--text);
      background: var(--bg);
      max-width: 860px;
      margin: 0 auto;
      padding: 40px 24px 80px;
    }
    .theme-toggle {
      position: fixed; top: 18px; right: 18px; z-index: 200;
      font-family: inherit; font-size: 11px; letter-spacing: 0.4px;
      padding: 6px 10px; border-radius: 4px;
      border: 1px solid var(--border-soft);
      background: var(--panel); color: var(--text); cursor: pointer;
    }
    .back-link { color: var(--muted); }
    .doc-switch a { color: var(--muted); }
    .doc-switch { font-size: 12px; margin: 0 0 28px; padding-bottom: 14px; border-bottom: 1px solid var(--border-soft); }
    .doc-switch a[aria-current="page"] { color: var(--text); font-weight: bold; text-decoration: none; }
    .doc-toc { font-size: 13px; margin: 0 0 28px; padding: 12px 16px; background: var(--panel); border: 1px solid var(--border-soft); }
    .doc-toc-title { font-size: 12px; margin: 0 0 8px; font-weight: bold; letter-spacing: 0.4px; text-transform: uppercase; color: var(--muted); }
    .doc-toc ul { list-style: none; margin: 0; padding: 0; columns: 2 240px; }
    .doc-toc li { margin: 0 0 4px; break-inside: avoid; }
    .doc-toc a { color: var(--link); }
    #doc .header-anchor { margin-left: 8px; font-size: 0.8em; font-weight: normal; text-decoration: none; color: var(--muted); }
    #doc :target { scroll-margin-top: 16px; }
    #doc h1 { font-size: 26px; margin: 0 0 20px; border-bottom: 2px solid var(--border); padding-bottom: 12px; }
    #doc h2 { font-size: 18px; margin: 36px 0 14px; border-bottom: 1px solid var(--border-soft); padding-bottom: 8px; }
    #doc h3 { font-size: 15px; margin: 26px 0 10px; }
    #doc h4 { font-size: 14px; margin: 20px 0 8px; }
    #doc p, #doc li { margin-bottom: 12px; }
    #doc ul, #doc ol { margin: 0 0 16px 24px; }
    #doc li { margin-bottom: 6px; }
    #doc a { color: var(--link); }
    #doc blockquote { border-left: 3px solid var(--border-soft); padding-left: 14px; color: var(--muted); margin-bottom: 16px; }
    #doc hr { border: none; border-top: 1px solid var(--border-soft); margin: 30px 0; }
    #doc code { background: var(--panel); padding: 1px 5px; border-radius: 3px; font-size: 13px; }
    #doc pre { background: var(--panel); border: 1px solid var(--border-soft); padding: 14px; overflow-x: auto; margin-bottom: 16px; }
    #doc pre code { background: none; padding: 0; }
    #doc table { border-collapse: collapse; width: 100%; margin: 16px 0; font-size: 13px; }
    #doc th, #doc td { border: 1px solid var(--border-soft); padding: 6px 10px; text-align: left; }
    #doc th { background: var(--panel); }
    .doc-source { margin-top: 48px; padding-top: 16px; border-top: 1px solid var(--border-soft); font-size: 12px; color: var(--muted); }
    .doc-source a { color: var(--muted); }

    @media (max-width: 768px) {
      .theme-toggle { position: static; display: inline-block; margin: 0 0 10px 0; }
    }
  </style>
{% endblock %}

{% block body %}
  <a href="/" class="back-link">&larr; Back to Database</a>

  <nav class="doc-switch" aria-label="Document">
    <a href="/methodology.html"{% if page_key == "methodology" %} aria-current="page"{% endif %}>Methodology</a> ·
    <a href="/verification-standards.html"{% if page_key == "verification-standards" %} aria-current="page"{% endif %}>Verification Standards</a>
  </nav>

  <main id="main-content">
    <nav class="doc-toc" aria-label="On this page">
      <p class="doc-toc-title">On this page</p>
      <ul>
{% for id, text in doc_toc %}        <li><a href="#{{ id }}">{{ text }}</a></li>
{% endfor %}      </ul>
    </nav>

    <div id="doc">
{{ doc_html }}    </div>

    <p class="doc-source">Rendered from the canonical markdown (single source):
      <a href="/{{ doc_source }}">view the source file</a>. Archived with the dataset at <a href="https://doi.org/10.5281/zenodo.22062862">Zenodo</a>.
      Questions or corrections: <a href="mailto:contact@aimortality.org">contact@aimortality.org</a>.</p>
  </main>
{% endblock %}
