{% extends "base.html.j2" %}
{% block head %}
{% endblock %}

{% block body %}
  <a href="/" class="back-link">&larr; Back to Database</a>

  <nav class="doc-switch" aria-label="Document">
    <a href="/methodology.html"{% if page_key == "methodology" %} aria-current="page"{% endif %}>Methodology</a> ·
    <a href="/verification-standards.html"{% if page_key == "verification-standards" %} aria-current="page"{% endif %}>Verification Standards</a>
  </nav>

  <main id="main-content">
    <nav class="doc-toc" aria-label="On this page">
      <p class="doc-toc-title">On this page</p>
      <ul>
{% for id, text in doc_toc %}        <li><a href="#{{ id }}">{{ text }}</a></li>
{% endfor %}      </ul>
    </nav>

    <div id="doc">
{{ doc_html }}    </div>

    <p class="doc-source">Rendered from the canonical markdown (single source):
      <a href="/{{ doc_source }}">view the source file</a>. Archived with the dataset at <a href="https://doi.org/10.5281/zenodo.22062862">Zenodo</a>.
      Questions or corrections: <a href="mailto:contact@aimortality.org">contact@aimortality.org</a>.</p>
  </main>
{% endblock %}
