      const media = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;

      const systemTheme = () => (media && media.matches ? 'dark' : 'light');
      const storedTheme = () => {
        const value = localStorage.getItem(storageKey);
        return value === 'dark' || value === 'light' ? value : null;
      };
      const currentTheme = () => root.dataset.theme || systemTheme();
      const setButton = (theme) => {
        toggle.textContent = `Theme: ${theme === 'dark' ? 'Dark' : 'Light'}`;
        toggle.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
      };

      const stored = storedTheme();
      if (stored) {
        root.dataset.theme = stored;
      }
      setButton(currentTheme());

      toggle.addEventListener('click', () => {
        const next = currentTheme() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem(storageKey, next);
        setButton(next);
      });

      if (media) {
        media.addEventListener('change', (event) => {
          if (!storedTheme()) {
            setButton(event.matches ? 'dark' : 'light');
          }
        });
      }
    })();
  </script>

</body>
</html>
